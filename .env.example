PORT=8080

# Cuenta de Gmail usada para enviar el correo de recuperación de contraseña.
# EMAIL_PASS debe ser una "contraseña de aplicación" de Google (no la contraseña normal de la cuenta):
# https://myaccount.google.com/apppasswords
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# URL base del frontend, usada para armar el enlace que llega en el correo
FRONTEND_URL=http://localhost:3000
