PORT=8080

# Cuenta de Gmail usada para enviar el correo de recuperación de contraseña.
# EMAIL_PASS debe ser una "contraseña de aplicación" de Google (no la contraseña normal de la cuenta):
# https://myaccount.google.com/apppasswords
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# URL base del frontend, usada para armar el enlace que llega en el correo
FRONTEND_URL=http://localhost:3000

# Clave para cifrar en base de datos la contraseña de la cuenta de correo
# parametrizada en Configuración > Correo de notificaciones (ver
# utilidades/cifrado.js). Si no se define, se deriva de JWT_SECRET como
# respaldo -funciona igual, pero en producción conviene fijar una propia-.
CLAVE_CIFRADO_CORREO=una-clave-larga-y-aleatoria
